rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "bhupeshkumar36882@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // ── Staff roles (Admin panel → System & Security → Staff & Roles) ──────────────────────────
    // Super admin upar wala email hai (full access). Baaki staff `staff/{email}` doc se: {role, active}.
    // get()/exists() sirf tab chalte hain jab isAdmin() false ho (|| short-circuit) — super admin ke liye koi extra read nahi.
    // Roles: editor (content/quiz/pyq), teacher (editor + doubts reply), notifier (notifications bhejna)
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.email.lower())).data;
    }
    function isStaff(roles) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower()))
        && staffDoc().get('active', false) == true
        && staffDoc().get('role', '') in roles;
    }
    // Block hua student naye doubts nahi bhej sakta (blockedUsers/{uid} sirf admin likh sakta hai)
    function notBlocked() {
      return !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    // Helper: field maujood na ho / null ho / ya string ho jiski length n se zyada na ho
    function okStr(d, k, n) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= n);
    }

    // Public read, sirf admin write
    match /_config/{doc}           { allow read: if true; allow write: if isAdmin(); }
    match /content/{doc}           { allow read: if true; allow write: if isAdmin() || isStaff(['editor','teacher']); }
    match /quizzes/{doc}           { allow read: if true; allow write: if isAdmin() || isStaff(['editor','teacher']); }
    match /pyq/{doc}               { allow read: if true; allow write: if isAdmin() || isStaff(['editor','teacher']); }
    match /notificationQueue/{doc} { allow read: if true; allow write: if isAdmin() || isStaff(['notifier']); }
    match /offers/{doc}            { allow read: if true; allow write: if isAdmin(); }   // offerwall — pehle ye rule nahi tha, isliye students ko offers dikhte hi nahi the

    // Doubts: student sirf apne doubts dekh/bhej sakta hai; reply/delete sirf admin.
    // Naya doubt sirf in fields ke saath, status 'pending' aur khali answer ke saath ban sakta hai
    // (taaki koi khud se nakli "answer" na likh sake).
    match /doubts/{doc} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid) || isStaff(['teacher']);
      allow create: if request.auth != null
        && notBlocked()
        && doc.matches('[A-Za-z0-9]{20}')   // app .add() se banti hai (auto-ID); apni marzi ki ID se admin panel me XSS ho sakta tha
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['board','subject','topic','text','name','date','status','answer','uid','deviceId'])
        && request.resource.data.keys().hasAll(['text','uid'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.answer == ''
        && okStr(request.resource.data, 'board', 40)
        && okStr(request.resource.data, 'subject', 100)
        && okStr(request.resource.data, 'topic', 200)
        && okStr(request.resource.data, 'name', 100)
        && okStr(request.resource.data, 'date', 40)
        && okStr(request.resource.data, 'deviceId', 100);
      allow update: if isAdmin() || isStaff(['teacher']);
      // Student apne doubts delete kar sake (account delete ke liye); doosron ke nahi
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // AI Doubts: AI se mila sawaal+jawaab student ke account me save rahe; sirf owner read/create kare.
    // Students saved AI answers ko overwrite ya kisi doosre user ko expose nahi kar sakte.
    match /aiDoubts/{doc} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && notBlocked()
        && request.resource.data.keys().hasOnly(['uid','board','subject','topic','question','answer','createdAt'])
        && request.resource.data.keys().hasAll(['uid','board','question','answer','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.board is string && request.resource.data.board.size() <= 40
        && request.resource.data.question is string && request.resource.data.question.size() >= 1 && request.resource.data.question.size() <= 8000
        && request.resource.data.answer is string && request.resource.data.answer.size() >= 1 && request.resource.data.answer.size() <= 20000
        && request.resource.data.createdAt is timestamp
        && okStr(request.resource.data, 'subject', 100)
        && okStr(request.resource.data, 'topic', 200);
      allow update, delete: if false;
    }

    // Students: list sirf admin; student sirf apna doc likh sakta hai
    // (login wale: doc id == uid, bina-login: "dev_..." device id)
    function studentKeys() {
      return ['name','username','usernameLower','photo','board','deviceId','lastActive','updatedAt','googleUid','email','fcmToken','createdAt'];
    }
    function photoOk() {
      return request.resource.data.get('photo', null) == null || request.resource.data.photo.size() < 120000;
    }
    // Har text field ki lambai par limit (limits kaafi khuli rakhi hain taaki normal students kabhi na atkein)
    function studentSane(d) {
      return okStr(d, 'name', 100)
        && okStr(d, 'username', 80)
        && okStr(d, 'usernameLower', 80)
        && okStr(d, 'board', 40)
        && okStr(d, 'deviceId', 100)
        && okStr(d, 'googleUid', 128)
        && okStr(d, 'email', 254)
        && okStr(d, 'fcmToken', 1024)
        && okStr(d, 'createdAt', 40);
    }
    function ownsStudentDoc(id) {
      return request.auth != null && request.auth.uid == id;
    }
    // email: khali/null chalega; warna apne Google login wala hi (koi doosre ka email na likh sake)
    function emailOk() {
      return !('email' in request.resource.data) || request.resource.data.email == null
        || request.resource.data.email.lower() == request.auth.token.email.lower();
    }
    match /students/{id} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == id);
      allow list: if isAdmin();
      allow create: if photoOk() && request.resource.data.keys().hasOnly(studentKeys()) && studentSane(request.resource.data) && emailOk() && ownsStudentDoc(id);
      // update me sirf wahi fields check hoti hain jo app badalta hai (server-side fields par asar nahi)
      allow update: if photoOk() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(studentKeys()) && studentSane(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) || emailOk()) && ownsStudentDoc(id);
      // Student apna record delete kar sakta hai (login wale: id == uid, bina-login: "dev_..." device id); baaki sirf admin
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == id);
    }

    // Staff list: sirf super admin badal sakta hai; staff apna doc padh sakta hai (admin panel ko role pata chale)
    match /staff/{email} {
      allow get: if request.auth != null && request.auth.token.email != null && email == request.auth.token.email.lower();
      allow list, write: if isAdmin();
    }

    // Blocked students: sirf admin likhta hai; student sirf apna doc padh sakta hai (app "account block" screen dikhaye).
    // Student apna block khud hata na sake isliye students/{id} se alag collection hai.
    match /blockedUsers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if isAdmin();
    }

    // Activity log: har admin/staff action. Likhna: super admin ya koi bhi active staff (apne hi email ke naam se);
    // padhna: sirf super admin. Koi bhi purana log badal/delete nahi kar sakta (append-only).
    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow create: if (isAdmin() || isStaff(['editor','teacher','notifier']))
        && request.resource.data.keys().hasOnly(['at','by','role','action','section','target','detail','ua'])
        && request.resource.data.by == request.auth.token.email.lower()
        && request.resource.data.action is string && request.resource.data.action.size() <= 80
        && okStr(request.resource.data, 'detail', 500)
        && okStr(request.resource.data, 'target', 200);
      allow update, delete: if false;
    }

    // Unique usernames (index.html ka claimUsername isi collection se check karta hai)
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && (isAdmin() || !(name in ['admin','administrator','eduspark','eduspark_official','official','support','teacher','moderator','owner']))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','username','updatedAt'])
        && name.size() <= 600
        && okStr(request.resource.data, 'username', 80);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Baaki sab (purane notes/quiz_history/_adminAuth wagairah) — sirf admin.
    // adminLogs par ye catch-all bhi lagta hai (rules OR hote hain), isliye "append-only" ka matlab: staff ke liye; super admin
    // ko Firebase Console me hamesha full access rehta hai. Admin panel khud kabhi log edit/delete nahi karta.
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
